{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atom.zelqane.com/contract/v1/publish-manifest.schema.json",
  "title": "POST /v1/publish/{id}/commit — manifeste de publication d'un instantané (service GPU → Worker)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "valid_time",
    "generated_at",
    "last_observation_at",
    "data_status",
    "versions",
    "files"
  ],
  "properties": {
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/snapshot_id"
    },
    "valid_time": {
      "$ref": "common.schema.json#/$defs/iso_utc"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/iso_utc"
    },
    "last_observation_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/iso_utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_status": {
      "$ref": "common.schema.json#/$defs/data_status"
    },
    "versions": {
      "$ref": "common.schema.json#/$defs/versions"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9][A-Za-z0-9_.-]*)*$",
            "description": "Relatif ; chaque segment commence par une lettre ou un chiffre (ni « .. » ni « _commit »)"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          }
        }
      },
      "description": "Fichiers de l'instantané, chemins relatifs à snapshots/{id}/. Ni meta.json ni terrain.f32 (fichiers du modèle)"
    }
  }
}
