# Copier ce fichier en `.env` (meme dossier, racine du depot) puis remplir les valeurs.
# `.env` est ignore par git et n'est jamais envoye sur Colab ; le service le lit au demarrage.
# Une variable deja posee dans l'environnement garde sa valeur.

# ------------------------------------------------------------- assistant ATOM Wind (chatbot)
# Cle OpenRouter : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modele (facultatif) : tout modele OpenRouter qui sait appeler des outils
PCFNO3D_ASSISTANT_MODELE_OPENROUTER=deepseek/deepseek-v4.1-flash
# Fournisseur (facultatif) : openrouter ou anthropic
# PCFNO3D_ASSISTANT_FOURNISSEUR=openrouter
# Claude a la place d'OpenRouter (facultatif)
# ANTHROPIC_API_KEY=
