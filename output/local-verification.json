      "result": {
        "tools": [
          {
            "description": "Geometrie de sortie du modele : grille, altitudes disponibles, modele charge.\n\n    A appeler en premier : les autres outils attendent des altitudes et des coordonnees\n    coherentes avec cette grille.\n    ",
            "inputSchema": {
              "properties": {},
              "type": "object",
              "title": "grid_metaArguments"
            },
