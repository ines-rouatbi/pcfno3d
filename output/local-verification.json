                  "type": "integer"
                }
              },
              "type": "object",
              "title": "list_instantsArguments"
            },
            "name": "list_instants"
          },
          {
            "description": "Vent reconstruit en un point : u, v, w, vitesse et direction meteo.\n\n    Args:\n        x_m: distance en metres vers l'est depuis le coin sud-ouest.\n        y_m: distance en metres vers le nord.\n        z_asl_m: altitude au-dessus du niveau de la mer, interpolee entre deux niveaux.\n        stem: instant (JJJ_HHMMSS) ; None = premier instant de test.\n    ",
            "inputSchema": {
              "properties": {
                "x_m": {
                  "title": "X M",
                  "type": "number"
                },
                "y_m": {
                  "title": "Y M",
                  "type": "number"
                },
                "z_asl_m": {
                  "title": "Z Asl M",
                  "type": "number"
                },
                "stem": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Stem"
                }
              },
              "required": [
                "x_m",
                "y_m",
                "z_asl_m"
              ],
              "type": "object",
              "title": "wind_at_pointArguments"
            },
            "name": "wind_at_point"
          },
          {
            "description": "Profil vertical complet en un point : une ligne par niveau du modele.\n\n    Utile pour un calcul de production eolienne : le vent a la hauteur de moyeu se lit\n    directement, et le cisaillement se voit d'un niveau a l'autre. Avec la fiabilite active,\n    chaque niveau porte aussi sigma, intervalle p10/p50/p90, statut, couverture et classe,\n    a null tant que `fiabilite` vaut en_cours (rappeler l'outil plus tard).\n\n    Args:\n        x_m: distance en metres vers l'est depuis le coin sud-ouest.\n        y_m: distance en metres vers le nord.\n        stem: instant (JJJ_HHMMSS) ; None = premier instant de test.\n    ",
            "inputSchema": {
              "properties": {
                "x_m": {
                  "title": "X M",
                  "type": "number"
                },
                "y_m": {
                  "title": "Y M",
                  "type": "number"
                },
                "stem": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Stem"
                }
              },
              "required": [
                "x_m",
                "y_m"
              ],
              "type": "object",
              "title": "wind_profileArguments"
            },
            "name": "wind_profile"
          },
          {
            "description": "Carte d'une variable a une altitude, decimee pour rester lisible.\n\n    Args:\n        z_asl_m: altitude ASL en metres (interpolee entre niveaux).\n        stem: instant (JJJ_HHMMSS) ; None = premier instant de test.\n        variable: \"speed\", \"u\", \"v\", \"w\" ou \"direction\".\n        stride: decimation horizontale (1-32) ; 8 donne une grille d'environ 60x30.\n    ",
            "inputSchema": {
              "properties": {
                "z_asl_m": {
                  "title": "Z Asl M",
                  "type": "number"
                },
                "stem": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Stem"
                },
                "variable": {
                  "default": "speed",
                  "title": "Variable",
                  "type": "string"
                },
                "stride": {
                  "default": 8,
                  "title": "Stride",
                  "type": "integer"
                }
              },
              "required": [
                "z_asl_m"
              ],
              "type": "object",
              "title": "wind_field_at_altitudeArguments"
            },
            "name": "wind_field_at_altitude"
          },
          {
            "description": "Resume chiffre d'un instant : vitesses par niveau, secteur dominant, temps d'inference.\n\n    Avec la fiabilite active : `fiabilite` (en_cours, prete, echec) et `fiabilite_s` (delai\n    de la fiabilite, null tant qu'elle n'est pas prete) ; inference_s = la valeur seule.\n\n    Args:\n        stem: instant (JJJ_HHMMSS) ; None = premier instant de test.\n    ",
            "inputSchema": {
              "properties": {
                "stem": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Stem"
                }
              },
              "type": "object",
              "title": "instant_summaryArguments"
            },
            "name": "instant_summary"
          },
          {
            "description": "Production du parc eolien declare a un instant (lot M5).\n\n    Par eolienne : vent au moyeu et vent equivalent rotor (REWS) avec intervalle p10/p50/p90,\n    cisaillement (exposant shear_alpha), rotation de direction (veer_deg), densite de l'air,\n    puissance et etat (production / arret_vent_faible / arret_vent_fort / indisponible) ;\n    puissance du parc ; alertes vent_fort_moyeu et cisaillement ; KPI hub_wind_* du domaine.\n    Hauteurs de moyeu AU-DESSUS DU SOL. Erreur si aucun parc n'est declare.\n\n    Args:\n        stem: instant (JJJ_HHMMSS) ; None = premier instant de test.\n    ",
            "inputSchema": {
              "properties": {
                "stem": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Stem"
                }
              },
              "type": "object",
              "title": "production_eolienneArguments"
            },
            "name": "production_eolienne"
          },
          {
            "description": "Dernier verdict DSO1-DSO5 archive pour le modele charge.\n\n    Renvoie le contenu de `test_summary.json` produit par l'evaluation. Si aucune\n    evaluation n'a encore ete archivee, le dit explicitement plutot que d'inventer\n    des chiffres.\n    ",
            "inputSchema": {
              "properties": {},
              "type": "object",
              "title": "dso_reportArguments"
            },
            "name": "dso_report"
          },
          {
            "description": "Alertes OUVERTES d'un instant (lot M4) : capteurs en derive ou muets, stations\n    insuffisantes, incoherence physique, derive des entrees, zones mal couvertes.\n\n    Chaque alerte porte un niveau (information, avertissement, important, critique), une\n    cause et une recommandation ; format du contrat ATOM rev. 2 (alerts.schema.json).\n    Renvoie aussi le nombre d'alertes ouvertes par niveau et le bloc `physique` (residu\n    de masse de l'instant). Si les alertes sont desactivees (alerts.enabled = false), le\n    dit au lieu d'inventer une liste vide.\n\n    Args:\n        stem: instant (JJJ_HHMMSS) ; None = dernieres alertes calculees, sinon le premier\n              instant de test.\n    ",
            "inputSchema": {
              "properties": {
